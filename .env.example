# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Auth0 SSO Configuration for vz.gay ecosystem
VITE_AUTH0_DOMAIN="accounts.vz.gay"
VITE_AUTH0_CLIENT_ID=""
VITE_AUTH0_REDIRECT_URI="https://myaccount.vz.gay/callback"
VITE_ACCOUNT_PORTAL_URL="https://myaccount.vz.gay"

# VZ Support Public Ticket Intake API & Cloudflare Turnstile (Public Site Key only; never put Turnstile secret here)
VITE_SUPPORT_API_URL="https://support.vz.gay"
VITE_SUPPORT_TURNSTILE_SITE_KEY="0x4AAAAAAGWaOorjmzmCqhEP"


